# Copia este ficheiro para .env.local e preenche os valores.
# Verifica com: npm run check:env

# --- Obrigatorias ---
MONGODB_URI=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Autenticacao com Google (opcional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Envio de email, usado pelo formulario de contacto (opcional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_EMAIL=

# --- Pagamentos, ainda nao implementados ---
STRIPE_SECRET_KEY=

# URL publico do site, usado no robots.txt e (mais tarde) no sitemap.
NEXT_PUBLIC_SITE_URL=https://petalasdesonho.pt

# Indexacao pelos motores de busca. Deixar por definir (ou diferente de "true")
# ate a camada legal obrigatoria estar publicada: identificacao do prestador,
# livro de reclamacoes, politica de privacidade e termos de venda.
SITE_INDEXAVEL=false

# Base para as ligacoes enviadas por email (verificacao e reposicao de
# palavra-passe). Sem isto, as ligacoes apontam para localhost.
# NEXT_PUBLIC_SITE_URL ja esta definido acima.
