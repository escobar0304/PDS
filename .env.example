# Copia este ficheiro para .env.local e preenche os valores.
# Verifica com: npm run check:env

# --- Obrigatorias ---
MONGODB_URI=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Autenticacao com Google (opcional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Envio de email ---
# Contacto, confirmacao de conta, reposicao da palavra-passe, e a confirmacao
# de cada encomenda paga — esta ultima obrigatoria: sem SMTP_HOST e
# ADMIN_EMAIL, a loja online nao abre (src/lib/loja.ts).
#
# Pela Gmail da loja, decidido em 25/09/2026. SMTP_USER e SMTP_FROM sao o
# endereco Gmail; SMTP_PASS e uma "palavra-passe de aplicacao" (Conta Google
# > Seguranca, com a verificacao em dois passos ligada), nunca a palavra-passe
# normal da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Para onde vai o aviso de cada encomenda paga, e as mensagens do contacto.
ADMIN_EMAIL=

# --- Pagamentos (Stripe, com a pagina alojada) ---
# Chaves de TESTE ate a loja abrir. O segredo do aviso vem do painel da Stripe
# (Programadores > Webhooks), para o endereco /api/pagamentos/aviso.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Abre a loja com portes e prazo INVENTADOS, para os testes de ponta a ponta
# (e2e-bd). So funciona com uma chave de testes. Nunca em producao.
# LOJA_ENSAIO=1

# URL publico do site, usado no robots.txt e (mais tarde) no sitemap.
NEXT_PUBLIC_SITE_URL=https://petalasdesonho.pt

# Indexacao pelos motores de busca. Deixar por definir (ou diferente de "true")
# ate a camada legal obrigatoria estar publicada: identificacao do prestador,
# livro de reclamacoes, politica de privacidade e termos de venda.
SITE_INDEXAVEL=false

# Base para as ligacoes enviadas por email (verificacao e reposicao de
# palavra-passe). Sem isto, as ligacoes apontam para localhost.
# NEXT_PUBLIC_SITE_URL ja esta definido acima.
